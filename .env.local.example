# Para desarrollo contra el Firebase Emulator Suite.
# Renómbralo a .env.local — Vite lo carga por encima de .env y no se sube a git.
# Con el emulador los valores de config no se validan; basta un projectId cualquiera.
VITE_FB_API_KEY=demo-api-key
VITE_FB_AUTH_DOMAIN=demo-bolsa.firebaseapp.com
VITE_FB_PROJECT_ID=demo-bolsa
VITE_FB_STORAGE_BUCKET=demo-bolsa.appspot.com
VITE_FB_SENDER_ID=000000000000
VITE_FB_APP_ID=1:000000000000:web:0000000000000000
VITE_HOST_PASSWORD=cambia-esta-clave
VITE_USE_EMULATOR=true
