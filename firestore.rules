rules_version = '2';
// Evento terminado (2026-09-04): base en solo lectura desde 2026-10-23.
// Para reabrirla, recuperar las reglas de escritura del commit 447aea4 y desplegar.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{coleccion}/{doc=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
