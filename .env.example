# Copia este archivo como .env y pega los valores de tu proyecto de Firebase
# (Consola > Configuración del proyecto > Tus apps > SDK setup and configuration > Config).
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_SENDER_ID=
VITE_FB_APP_ID=

# Contraseña del panel /host. Cámbiala antes del evento.
VITE_HOST_PASSWORD=cambia-esta-clave

# Deja "false" para apuntar al proyecto real.
VITE_USE_EMULATOR=false
